{
  "name": "chipwreck",
  "version": "0.1.0",
  "description": "ChipWreck: real cards, digital chips. Virtual poker chips for Texas Hold'em nights",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.js",
    "build:check": "node build.js && git diff --exit-code dist docs",
    "icons": "node tools/make-icons.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test \"test/*.test.ts\"",
    "test:ui": "python3 test/ui_smoke.py",
    "serve": "npx --yes serve docs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "type": "module"
}
